rules_version = '2';

// Nur die beiden Firmen-Konten dürfen überhaupt lesen/schreiben - unabhängig
// davon, was das Frontend (login.html / __authGate) macht. Das ist die
// serverseitige Absicherung: selbst wenn jemand die Firebase-Zugangsdaten
// aus dem HTML-Quellcode ausliest und direkt auf die Datenbank zugreift
// (unter Umgehung von login.html), kommt er ohne eine dieser beiden
// E-Mail-Adressen trotzdem nicht an die Daten.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null &&
        request.auth.token.email in ['agnello.baden@gmail.com', 'eisfavorit@gmail.com'];
    }

    // eisfavorite.de (die öffentliche Marketing-Website) schreibt
    // unauthentifiziert Anfragen von Besuchern in diese Collection - das
    // muss trotz der sonst strikten Owner-only-Sperre möglich bleiben.
    // Lesen/Ändern/Löschen bleibt dem Owner vorbehalten (Besucher sollen
    // keine fremden Anfragen einsehen können).
    match /bookings/{bookingId} {
      allow create: if true;
      allow read, update, delete: if isOwner();
    }

    // Event-Fotos: Veranstalter dürfen unauthentifiziert neue Uploads anlegen
    // (immer mit status:'pending', damit niemand sich selbst freischalten
    // kann). Öffentlich sichtbar/lesbar wird ein Upload erst, nachdem der
    // Owner ihn manuell auf 'approved' gesetzt hat.
    match /eventPhotos/{photoId} {
      allow create: if request.resource.data.status == 'pending'
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.title.size() < 200;
      allow read: if resource.data.status == 'approved' || isOwner();
      allow update, delete: if isOwner();
    }

    // Newsletter-Anmeldung (Double-Opt-in) von eisfavorite.de: die Doc-ID IST
    // der zufällige Bestätigungs-Token, den der Besucher per E-Mail bekommt.
    // Anlegen (Status "pending") darf jeder unauthentifizierte Besucher, die
    // Bestätigung (pending -> confirmed) darf ebenfalls unauthentifiziert
    // passieren - aber nur mit genau diesem Token als Doc-ID (wer den Link
    // aus der E-Mail nicht kennt, kann den Token nicht erraten) und nur als
    // exakt dieser eine Statuswechsel, sonst nichts. Einzelnes Lesen per
    // bekanntem Token ist ebenfalls erlaubt (die Bestätigungsseite braucht
    // die E-Mail-Adresse, um daraus den Werbung-Lead anzulegen - siehe
    // marketingLeads unten) - das ist keine zusätzliche Offenlegung, wer den
    // Token kennt, kann den Eintrag ohnehin schon bestätigen. Auflisten aller
    // Anmeldungen und Löschen bleibt dem Owner vorbehalten.
    match /newsletterSubscribers/{token} {
      allow create: if request.resource.data.status == 'pending'
                    && request.resource.data.email is string
                    && request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
                    && request.resource.data.keys().hasOnly(['email', 'status', 'createdAt']);
      allow update: if resource.data.status == 'pending'
                    && request.resource.data.status == 'confirmed'
                    && request.resource.data.email == resource.data.email
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'confirmedAt']);
      allow get: if true;
      allow list, delete: if isOwner();
    }

    // Sobald eine Newsletter-Anmeldung bestätigt ist (siehe oben), legt
    // eisfavorite.de selbst - unauthentifiziert - einen passenden Eintrag in
    // der Werbung-Adressliste (werbung.html) an, Kategorie fest "newsletter"
    // und Doc-ID fest "newsletter-<token>". So landen dort ausschließlich
    // Leute, die aktiv und bestätigt zugestimmt haben - nie die recherchierten
    // Firmen-/Vereins-Kaltakquise-Leads. Lesen/Ändern/Löschen bleibt dem
    // Owner vorbehalten wie bei allen anderen marketingLeads-Einträgen.
    match /marketingLeads/{leadId} {
      allow create: if leadId.matches('^newsletter-.+$')
                    && request.resource.data.category == 'newsletter'
                    && request.resource.data.email is string
                    && request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
                    && request.resource.data.keys().hasOnly(['name', 'category', 'email', 'sourceType', 'sourceToken', 'status', 'createdAtMs', 'lastModifiedMs']);
      allow read, update, delete: if isOwner();
    }

    // Winziges öffentliches Meta-Dokument (z.B. "gibt es freigegebene Fotos?"),
    // damit die Website nicht bei jedem Seitenaufruf die komplette
    // eventPhotos-Collection samt Bilddaten abfragen muss, nur um zu prüfen,
    // ob überhaupt etwas anzuzeigen ist.
    match /siteMeta/{docId} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /{document=**} {
      allow read, write: if isOwner();
    }
  }
}
