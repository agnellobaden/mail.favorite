{
  "name": "EisFavorite: Personalisierte Flyer-HTML-E-Mail (aus werbung.html)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "werbung-flyer-email",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook",
      "name": "Webhook: Flyer-E-Mail senden",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "functionCode": "// Erwartet im Webhook-Body: { leadId, name, email, contactPerson }\n// Baut eine eigenständige HTML-E-Mail (inline CSS, ohne externe Bilder) im\n// EisFavorite-Design, personalisiert mit Ansprechpartner/Firmenname.\nconst d = $json.body || $json;\n\nconst rawContact = (d.contactPerson || '').replace(/\\(.*?\\)/g, '').trim();\nconst firstPerson = rawContact ? rawContact.split(',')[0].trim() : '';\nconst greeting = firstPerson ? ('Hallo ' + firstPerson + ',') : 'Sehr geehrte Damen und Herren,';\n\nconst flyerUrl = 'https://maileisfavorite.vercel.app/flyer-firmen.html'\n  + '?firma=' + encodeURIComponent(d.name || '')\n  + (firstPerson ? '&name=' + encodeURIComponent(firstPerson) : '');\n\nconst html = `\n<div style=\"font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; max-width:600px; margin:0 auto; background:#ffffff; border-radius:14px; overflow:hidden; border:1px solid #eee;\">\n  <div style=\"background:linear-gradient(135deg, #667eea 0%, #764ba2 100%); background-color:#667eea; color:#ffffff; text-align:center; padding:32px 20px 40px;\">\n    <div style=\"font-size:2.4em; line-height:1;\">🍦</div>\n    <div style=\"font-weight:700; letter-spacing:0.5px; margin-top:6px;\">EisFavorite</div>\n    <h1 style=\"font-size:1.5em; margin:16px 0 8px;\">Eine süße Überraschung für das Team von ${d.name || 'Ihnen'}</h1>\n    <p style=\"font-size:1.05em; opacity:0.95; margin:0;\">Motivation, die schmilzt: Eis für Ihre Mitarbeiter als Dankeschön.</p>\n  </div>\n  <div style=\"padding:28px 26px;\">\n    <p style=\"color:#333; font-size:1.05em; margin:0 0 16px;\">${greeting}</p>\n    <p style=\"color:#555; line-height:1.7; font-size:1.02em; margin:0 0 18px;\">\n      ob als spontane Belohnung, zum Sommerfest, Betriebsjubiläum oder einfach als Dankeschön für den\n      Einsatz Ihres Teams bei <strong>${d.name || ''}</strong> - EisFavorite kommt mit dem Eiswagen zu Ihnen\n      und verwöhnt Ihre Mitarbeiterinnen und Mitarbeiter mit frisch zubereitetem Eis direkt vor Ort.\n    </p>\n    <table role=\"presentation\" width=\"100%\" style=\"border-collapse:collapse; margin:20px 0;\">\n      <tr>\n        <td style=\"width:25%; text-align:center; padding:10px; background:#f8f9fa; border-radius:10px;\">🚚<br><span style=\"font-size:0.85em; font-weight:600; color:#333;\">Wir kommen zu Ihnen</span></td>\n        <td style=\"width:4%;\"></td>\n        <td style=\"width:25%; text-align:center; padding:10px; background:#f8f9fa; border-radius:10px;\">🍨<br><span style=\"font-size:0.85em; font-weight:600; color:#333;\">Frisches Eis vor Ort</span></td>\n        <td style=\"width:4%;\"></td>\n        <td style=\"width:25%; text-align:center; padding:10px; background:#f8f9fa; border-radius:10px;\">😊<br><span style=\"font-size:0.85em; font-weight:600; color:#333;\">Freude fürs Team</span></td>\n      </tr>\n    </table>\n    <div style=\"text-align:center; margin:26px 0 10px;\">\n      <a href=\"${flyerUrl}\" target=\"_blank\" style=\"display:inline-block; background:linear-gradient(135deg, #ff9800 0%, #f57c00 100%); background-color:#f57c00; color:#ffffff; text-decoration:none; font-weight:700; font-size:1.1em; padding:15px 38px; border-radius:50px;\">🍦 Jetzt unverbindlich anfragen</a>\n      <p style=\"margin-top:10px; color:#888; font-size:0.85em;\">Klicken Sie hier für mehr Infos und um direkt anzufragen</p>\n    </div>\n  </div>\n  <div style=\"background:#f8f9fa; padding:22px 26px; text-align:center; color:#666; font-size:0.85em; line-height:1.8; border-top:1px solid #eee;\">\n    <strong style=\"color:#333;\">Eis Agnello · EisFavorite</strong><br>\n    Favoritenstrasse 11 · 76456 Kuppenheim<br>\n    Tel: +49 176 56813172 · eisfavorit@gmail.com<br><br>\n    Kein Interesse? Einfach mit \"Kein Interesse\" antworten.\n  </div>\n</div>\n`;\n\nreturn [{\n  json: {\n    leadId: d.leadId || '',\n    name: d.name || '',\n    email: d.email || '',\n    subject: 'Eine süße Überraschung für das Team von ' + (d.name || ''),\n    html\n  }\n}];"
      },
      "id": "build-html",
      "name": "Personalisierte HTML-E-Mail bauen",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [470, 300]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.email }}",
        "subject": "={{ $json.subject }}",
        "message": "={{ $json.html }}",
        "options": {
          "bccList": "eisfavorit@gmail.com"
        }
      },
      "id": "gmail-send",
      "name": "Gmail: HTML-E-Mail senden",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [690, 300],
      "credentials": {
        "gmailOAuth2": {
          "id": "DEINE_GMAIL_CREDENTIALS",
          "name": "eisfavorit@gmail.com"
        }
      }
    },
    {
      "parameters": {
        "operation": "update",
        "projectId": "mailfavorite-e8f49",
        "collection": "marketingLeads",
        "documentId": "={{ $json.leadId }}",
        "updateFields": {
          "fields": [
            { "name": "status", "value": "kontaktiert" },
            { "name": "lastContactedAt", "value": "={{ Date.now() }}" },
            { "name": "lastModifiedMs", "value": "={{ Date.now() }}" }
          ]
        }
      },
      "id": "firebase-update",
      "name": "Lead-Status aktualisieren",
      "type": "n8n-nodes-base.googleFirebaseCloudFirestore",
      "typeVersion": 1,
      "position": [910, 300],
      "credentials": {
        "googleFirebaseCloudFirestoreOAuth2Api": {
          "id": "DEINE_FIREBASE_CREDENTIALS",
          "name": "Firebase Service Account"
        }
      }
    }
  ],
