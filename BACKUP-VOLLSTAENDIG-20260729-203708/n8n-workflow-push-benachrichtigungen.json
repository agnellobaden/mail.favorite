    {
      "parameters": {
        "functionCode": "// Kreuzprodukt: jede Nachricht x jeder Token = eine FCM-Sendeanfrage\nconst messages = $items('Filtere: Neue Buchungen').map(i => i.json);\nconst tokens = $items('Push-Tokens laden').map(i => i.json);\nconst out = [];\nmessages.forEach(msg => {\n  tokens.forEach(t => {\n    out.push({ json: { fcmToken: t.token || t.id, title: msg.title, body: msg.body } });\n  });\n});\nreturn out;"
      },
      "id": "crossjoin-neu",
      "name": "Nachricht x Token (neu)",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [1050, 100]
    },
