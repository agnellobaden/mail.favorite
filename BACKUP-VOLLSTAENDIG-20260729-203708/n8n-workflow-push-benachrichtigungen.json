    {
      "parameters": {
        "functionCode": "// Rechnungen, die als bezahlt markiert wurden, noch nicht gemeldet\nconst bookings = $input.all().map(item => item.json);\nconst toNotify = bookings.filter(b => b.invoicePaid === true && b.pushPaidSent !== true);\nconsole.log(`💰 Zahlungseingänge für Push: ${toNotify.length}`);\nreturn toNotify.map(b => ({\n  json: {\n    id: b.id,\n    title: '💰 Zahlung eingegangen',\n    body: (b.name || 'Kunde') + (b.invoiceAmount ? ' - ' + b.invoiceAmount : '') + ' wurde als bezahlt markiert'\n  }\n}));"
      },
      "id": "filter-zahlung",
      "name": "Filtere: Zahlung eingegangen",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [650, 600]
    },
