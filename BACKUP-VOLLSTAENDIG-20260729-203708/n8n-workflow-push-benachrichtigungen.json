      },
      "id": "trigger-neue-buchung",
      "name": "Alle 5 Min: Neue Buchung?",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [250, 100]
    },
    {
      "parameters": {
        "operation": "getAll",
        "projectId": "mailfavorite-e8f49",
        "collection": "bookings",
        "returnAll": true
      },
      "id": "get-bookings-neu",
      "name": "Buchungen laden (neu)",
      "type": "n8n-nodes-base.googleFirebaseCloudFirestore",
      "typeVersion": 1,
      "position": [450, 100],
      "credentials": {
        "googleFirebaseCloudFirestoreOAuth2Api": {
          "id": "DEINE_FIREBASE_CREDENTIALS",
          "name": "Firebase Service Account"
        }
      }
    },
    {
      "parameters": {
        "functionCode": "// Neue, noch nicht gemeldete Buchungen\nconst bookings = $input.all().map(item => item.json);\nconst toNotify = bookings.filter(b => b.status === 'Neu' && b.pushNewSent !== true);\nconsole.log(`🆕 Neue Buchungen für Push: ${toNotify.length}`);\nreturn toNotify.map(b => ({\n  json: {\n    id: b.id,\n    title: '🆕 Neue Buchung/Anfrage',\n    body: (b.name || 'Unbekannt') + (b.date ? ' - ' + b.date : '') + (b.company ? ' (' + b.company + ')' : '')\n  }\n}));"
      },
      "id": "filter-neu",
      "name": "Filtere: Neue Buchungen",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [650, 100]
    },
    {
      "parameters": {
        "rule": {
          "interval": [{ "cronExpression": "0 9 * * *" }]
        }
      },
      "id": "trigger-24h",
      "name": "Täglich 9:00: 24h-Erinnerung",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [250, 350]
    },
    {
      "parameters": {
        "operation": "getAll",
        "projectId": "mailfavorite-e8f49",
        "collection": "bookings",
        "returnAll": true
      },
      "id": "get-bookings-24h",
      "name": "Buchungen laden (24h)",
      "type": "n8n-nodes-base.googleFirebaseCloudFirestore",
      "typeVersion": 1,
      "position": [450, 350],
      "credentials": {
        "googleFirebaseCloudFirestoreOAuth2Api": {
          "id": "DEINE_FIREBASE_CREDENTIALS",
          "name": "Firebase Service Account"
        }
      }
    },
    {
      "parameters": {
        "functionCode": "// Termine in 20-28h, noch keine Push-Erinnerung gesendet\nconst now = new Date();\nconst bookings = $input.all().map(item => item.json);\n\nconst toNotify = bookings.filter(b => {\n  if (b.status !== 'Gebucht') return false;\n  if (b.pushReminderSent === true) return false;\n  if (!b.date) return false;\n  const [day, month, year] = b.date.split('.');\n  const eventDate = new Date(year, month - 1, day);\n  if (b.time) {\n    const [h, m] = b.time.split(':');\n    eventDate.setHours(h, m);\n  } else {\n    eventDate.setHours(14, 0);\n  }\n  const hoursUntil = (eventDate - now) / (1000 * 60 * 60);\n  return hoursUntil >= 20 && hoursUntil <= 28;\n});\n\nconsole.log(`⏰ 24h-Erinnerungen für Push: ${toNotify.length}`);\nreturn toNotify.map(b => ({\n  json: {\n    id: b.id,\n    title: '⏰ Termin morgen',\n    body: (b.name || 'Kunde') + ' - ' + b.date + (b.time ? ' um ' + b.time + ' Uhr' : '')\n  }\n}));"
      },
      "id": "filter-24h",
      "name": "Filtere: 24h vor Termin",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [650, 350]
    },
    {
      "parameters": {
        "rule": { "interval": [{ "field": "minutes", "minutesInterval": 5 }] }
      },
